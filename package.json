{
  "name": "cartoboost-docs",
  "version": "0.3.13",
  "private": true,
  "description": "CartoBoost documentation site.",
  "scripts": {
    "start": "docusaurus start",
    "build:wasm": "node -e \"require('fs').rmSync('static/wasm/cartoboost', { recursive: true, force: true })\" && wasm-pack build crates/cartoboost-wasm --target web --out-dir ../../static/wasm/cartoboost --release --no-pack",
    "prebuild": "npm run build:wasm",
    "build": "docusaurus build",
    "serve": "docusaurus serve",
    "clear": "docusaurus clear",
    "typecheck": "tsc --noEmit",
    "test:ui": "node --import tsx --test tests/js/*.test.ts",
    "check": "npm run typecheck && npm run build"
  },
  "dependencies": {
    "@deck.gl/aggregation-layers": "^9.3.4",
    "@deck.gl/core": "^9.3.4",
    "@deck.gl/layers": "^9.3.4",
    "@deck.gl/mapbox": "^9.3.4",
    "@docusaurus/core": "3.10.2",
    "@docusaurus/plugin-client-redirects": "3.10.2",
    "@docusaurus/preset-classic": "3.10.2",
    "@docusaurus/theme-mermaid": "3.10.2",
    "@easyops-cn/docusaurus-search-local": "^0.55.2",
    "@mdx-js/react": "^3.1.0",
    "@mermaid-js/layout-elk": "0.1.9",
    "@types/d3": "^7.4.3",
    "apache-arrow": "^21.1.0",
    "clsx": "^2.1.1",
    "d3": "^7.9.0",
    "h3-js": "^4.5.0",
    "maplibre-gl": "6.19.0",
    "parquet-wasm": "^0.7.1",
    "prism-react-renderer": "^2.4.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "s2-geometry": "^1.2.10"
  },
  "devDependencies": {
    "@docusaurus/module-type-aliases": "3.10.2",
    "@docusaurus/tsconfig": "3.10.2",
    "tsx": "^4.22.4",
    "typescript": "~5.8.3",
    "wasm-pack": "0.15.1"
  },
  "engines": {
    "node": ">=22.0"
  },
  "overrides": {
    "serialize-javascript": "^7.1.4",
    "tinypool": "^2.2.0",
    "qs": "^6.17.1",
    "katex": "^0.19.1",
    "sockjs": {
      "uuid": "^11.1.1"
    }
  }
}
